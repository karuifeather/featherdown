{
  "name": "@karuifeather/featherdown",
  "version": "0.5.1",
  "unstable": [
    "sloppy-imports"
  ],
  "imports": {
    "hast": "npm:@types/hast@^3.0.4",
    "mdast": "npm:@types/mdast@^4.0.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./advanced": "./src/advanced.ts",
    "./legacy": "./src/legacy.ts"
  },
  "publish": {
    "exclude": [
      ".git/",
      ".github/",
      "coverage/",
      "dist/",
      "node_modules/",
      "test/",
      ".gitignore",
      "package-lock.json",
      "site/",
      "scripts/",
      "npm-smoke-test/",
      "eslint.config.js",
      "tsup.config.ts",
      "vitest.config.ts",
      "RELEASING.md"
    ]
  }
}
